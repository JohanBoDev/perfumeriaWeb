---
import Layout from "../layouts/Layout.astro";
import '../styles/global.css';
import HeaderDesktop from "@/components/HeaderDesktop.jsx";
import HeaderMobile from "@/components/HeaderMobile.jsx";
import HeroSlider from "../components/Slider/HeroSlider.jsx";
import PerfumesCarousel from "@/components/CarrouselPerfumes.jsx";
import BannerPromo from "@/components/BannerPromo.astro";
import MetodoPagoCarousel from "@/components/MetodoPagoCarousel.jsx";
import Footer from "@/components/Footer.astro";
import MapaUbicacion from "@/components/MapaUbicacion.astro";

---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="vercel-insights" content="false" />

  <!-- SEO -->
  <title>Shesman Perfumes Premium | Fragancias Originales para Hombres y Mujeres</title>
  <meta name="description" content="Compra perfumes 100% originales en Colombia. Descubre fragancias de Carolina Herrera, Versace, Paco Rabanne y más. Envío rápido y atención personalizada.">
  
    <meta name="keywords" content="Shesman, perfumes premium, catálogo perfumes, fragancias hombre, fragancias mujer, perfumes exclusivos, ofertas perfumes" />
    <meta name="author" content="Shesman Perfumes" />
    <meta name="robots" content="index, follow" />
  
    <!-- Open Graph / Redes Sociales -->
<!-- Open Graph (para compartir en redes sociales) -->
<meta property="og:title" content="Shesman Perfumes Premium | Perfumes Originales de Alta Gama" />
<meta property="og:description" content="Descubre fragancias auténticas para hombres y mujeres. Marcas como Carolina Herrera, Versace y más. Compra online con confianza en Shesman." />
<meta property="og:image" content="https://www.shesmanperfumes.com/img/img-muestra.jpg" />
<meta property="og:url" content="https://www.shesmanperfumes.com/" />
<meta property="og:type" content="website" />
<meta property="og:locale" content="es_CO" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Shesman Perfumes Premium | Catálogo Exclusivo" />
    <meta name="twitter:description" content="Descarga o explora en línea nuestro catálogo con fragancias para cada personalidad." />
    <meta name="twitter:image" content="/img/preview-catalogo.png" />
  
    <!-- Favicon -->
    <link rel="icon" href="/img/favicon_shesman_white.ico" type="image/x-icon" />
  </head>
  <Layout>
  <body class="relative min-h-screen w-full text-texto transition-colors duration-300 overflow-x-hidden">
    
    <!-- NUEVO FONDO -->
    <div class="absolute inset-0 -z-10 h-full w-full bg-white bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:16px_16px]"></div>

    <HeaderDesktop />
    <HeaderMobile client:load />
    <main class="mt-16">
        <BannerPromo />
        <HeroSlider  client:only="react" />
        <section class="container mx-auto px-4 py-8">
            <PerfumesCarousel client:only="react" />
    
            <MetodoPagoCarousel client:only="react" />
            <MapaUbicacion />
        </section>
    </main>
    
  </body>
</Layout>
</html>
