---
import Layout from "../layouts/Layout.astro";
import HeroSlider from "../components/Slider/HeroSlider.jsx";
import PerfumesCarousel from "@/components/CarrouselPerfumes.jsx";
import MetodoPagoCarousel from "@/components/MetodoPagoCarousel.jsx";
import MapaUbicacion from "@/components/MapaUbicacion.astro";
---

<Layout
  title="Shesman Perfumes Premium | Fragancias Originales para Hombres y Mujeres"
  description="Compra perfumes 100% originales en Colombia. Descubre fragancias de Carolina Herrera, Versace, Paco Rabanne y más. Envío rápido y atención personalizada."
  ogImage="https://www.shesmanperfumes.com/img/img-muestra.webp"
  ogUrl="https://www.shesmanperfumes.com/"
>
  <HeroSlider client:only="react" />
  <section class="container mx-auto px-4 py-8">
    <PerfumesCarousel client:only="react" />
    <MetodoPagoCarousel client:only="react" />
    <MapaUbicacion />
  </section>
</Layout>
