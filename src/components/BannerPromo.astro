---
const img = "/img/seccion-off.webp"; // Asegúrate de que esté en public/img
---

<section class="w-full flex justify-center items-center px-4 mt-20">
  <div class="max-w-6xl w-full flex flex-col items-center text-center gap-6">

    <img
    src={img}
    alt="Shesman Perfumes 100% Originales con Descuento"
    width="400"
    height="400"
    class="w-full max-w-2xl h-auto"
    fetchpriority="high"
    decoding="async"
  />
      <a
      href={`https://wa.me/573224395306?text=Hola!%20Estoy%20interesado%20en%20los%20perfumes%20que%20ofrecen.%20Quisiera%20saber%20más%20sobre%20los%20descuentos.`}
      target="_blank"
      rel="noopener noreferrer"
    >
  
  
      <p class="text-lg text-gray-700">
        Fragancias auténticas, elegantes y con descuentos exclusivos por tiempo
        limitado.
      </p>
    </a>
  </div>
</section>
