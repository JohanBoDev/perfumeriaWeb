---
import HeaderDesktop from "../components/HeaderDesktop.jsx";
import HeaderMobile from "../components/HeaderMobile.jsx";
import HeroSlider from "../components/Slider/HeroSlider.jsx";
import PerfumesCarousel from "@/components/CarrouselPerfumes.jsx";
import BannerPromo from "@/components/BannerPromo.astro";
import MetodoPagoCarousel from "@/components/MetodoPagoCarousel.jsx";
import Footer from "@/components/Footer.astro";
import MapaUbicacion from "@/components/MapaUbicacion.astro";
---

<head>
    <title>Inicio | Shesman Perfumes Premium - Perfumes Originales en Bogotá</title>
    <meta name="description" content="Página de inicio de Shesman Perfumes Premium. Descubre perfumes originales y exclusivos para ti." />
    <meta name="robots" content="index, follow" />
  
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-M6RGXWTP3S"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(...args) {
        dataLayer.push(args);
      }
      gtag('js', new Date());
      gtag('config', 'G-M6RGXWTP3S');
    </script>
    
  </head>
  
<HeaderDesktop />
<HeaderMobile client:load />
<main class="mt-16">
    <BannerPromo />
    <HeroSlider  client:only="react" />
    <section class="container mx-auto px-4 py-8">
        <PerfumesCarousel client:only="react" />

        <MetodoPagoCarousel client:only="react" />
        <MapaUbicacion />
    </section>
    <Footer />
</main>
