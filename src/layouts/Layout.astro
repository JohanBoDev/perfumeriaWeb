---
import HeaderDesktop from "../components/HeaderDesktop.jsx";
import HeaderMobile from "../components/HeaderMobile.jsx";
import Footer from "@/components/Footer.astro";

const {
  title = "Shesman Perfumes Premium",
  description = "Perfumes originales para hombre y mujer. Compra segura en Shesman Perfumes.",
  ogImage = "https://www.shesmanperfumes.com/img/img-muestra.webp",
  ogUrl = "https://www.shesmanperfumes.com",
} = Astro.props;
---

<html lang="es">
  <head>
    <!-- Google Tag Manager -->
    <script is:raw>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id=GTM-WQCKFM88'+dl;f.parentNode?.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-WQCKFM88');
    </script>
    <!-- End Google Tag Manager -->

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" href="/img/favicon_shesman_white.ico" type="image/x-icon" />
  </head>

  <body class="bg-white text-neutral-800 scroll-smooth">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WQCKFM88"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!-- NUEVO FONDO -->
    <div class="absolute inset-0 -z-10 h-full w-full bg-white bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:16px_16px]"></div>

    <HeaderDesktop />
    <HeaderMobile client:load />
    <main class="mt-16">
      <slot />
    </main>
    <Footer />
  </body>
</html>
