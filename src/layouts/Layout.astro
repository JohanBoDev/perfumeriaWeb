---
// src/layouts/Layout.astro
import HeaderDesktop from "../components/HeaderDesktop.jsx";
import HeaderMobile from "../components/HeaderMobile.jsx";
import Footer from "@/components/Footer.astro";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shesman Perfumes Premium</title>
    <meta name="description" content="Perfumes originales para hombre y mujer. Compra segura en Shesman Perfumes." />
    <meta name="robots" content="index, follow" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-M6RGXWTP3S"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(...args) {
        dataLayer.push(args);
      }
      gtag('js', new Date());
      gtag('config', 'G-M6RGXWTP3S');
    </script>
  </head>

  <body class="bg-white text-neutral-800">
    <HeaderDesktop />
    <HeaderMobile client:load />

    <main class="mt-16">
      <slot /> <!-- Aquí se inyectará el contenido de cada página -->
    </main>

    <Footer />
  </body>
</html>
